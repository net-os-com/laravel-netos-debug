{
    "name": "net-os/laravel-netos-debug",
    "description": "Ships debugbar data for every request to the NetOS Debug desktop app.",
    "keywords": [
        "net-os",
        "laravel",
        "debugbar",
        "ray",
        "debugging"
    ],
    "homepage": "https://github.com/net-os-com/laravel-netos-debug",
    "license": "MIT",
    "authors": [
        {
            "name": "Net OS B.V.",
            "homepage": "https://net-os.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-debugbar": "^4.4",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-ray": "^1.40"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0||^11.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "NetOs\\Debug\\": "src/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NetOs\\Debug\\NetOsDebugServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
